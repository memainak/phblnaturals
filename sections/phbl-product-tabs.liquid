{%- comment -%}
  Product carousel with optional tabs. One block = one collection. One block = plain carousel (New Launches, Combos);
  several blocks = tabbed (Bestsellers: Face | Body | Hair).
{%- endcomment -%}
<div class="phbl-section page-width" style="background: {{ section.settings.bg }}">
  <div class="phbl-heading">
    <h2 class="h3">{{ section.settings.heading }}</h2>
    {%- assign first_c = section.blocks.first.settings.collection -%}
    {%- if section.settings.show_view_all and first_c != blank -%}<a href="{{ first_c.url }}">{{ 'phbl.general.view_all' | t }} →</a>{%- endif -%}
  </div>
  <phbl-tabs>
    {%- if section.blocks.size > 1 -%}
      <div class="phbl-tabs" role="tablist">
        {%- for block in section.blocks -%}
          <button type="button" role="tab" class="phbl-pill{% if forloop.first %} is-active{% endif %}" id="Tab-{{ block.id }}" aria-controls="Panel-{{ block.id }}" aria-selected="{{ forloop.first }}" {{ block.shopify_attributes }}>
            {{ block.settings.label | default: block.settings.collection.title }}
          </button>
        {%- endfor -%}
      </div>
    {%- endif -%}
    {%- for block in section.blocks -%}
      {%- assign c = block.settings.collection -%}
      <div class="phbl-tab-panel" role="tabpanel" id="Panel-{{ block.id }}" aria-labelledby="Tab-{{ block.id }}" {% unless forloop.first %}hidden{% endunless %}>
        <div class="phbl-scroller" id="Track-{{ block.id }}">
          {%- if c != blank -%}
            {%- for product in c.products limit: section.settings.limit -%}
              {%- render 'phbl-card', product: product -%}
            {%- endfor -%}
          {%- else -%}
            {%- for i in (1..4) -%}<div class="phbl-card"><div class="phbl-card__media">{{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}</div><div class="phbl-card__body"><p>{{ 'phbl.general.pick_collection' | t }}</p></div></div>{%- endfor -%}
          {%- endif -%}
        </div>
      </div>
    {%- endfor -%}
  </phbl-tabs>
</div>
{% schema %}
{
  "name": "PHBL Product carousel",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Bestsellers" },
    { "type": "range", "id": "limit", "label": "Products per tab", "min": 4, "max": 16, "step": 1, "default": 8 },
    { "type": "checkbox", "id": "show_view_all", "label": "Show 'View all'", "default": true },
    { "type": "color", "id": "bg", "label": "Background", "default": "#FFFFFF" }
  ],
  "blocks": [
    {
      "type": "tab",
      "name": "Collection tab",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Collection" },
        { "type": "text", "id": "label", "label": "Tab label (optional)" }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    { "name": "PHBL Product carousel", "blocks": [{ "type": "tab" }] },
    { "name": "PHBL Bestsellers (tabbed)", "settings": { "heading": "Bestsellers" }, "blocks": [{ "type": "tab" }, { "type": "tab" }, { "type": "tab" }] }
  ]
}
{% endschema %}
