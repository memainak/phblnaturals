<div class="phbl-section page-width">
  {%- if section.settings.heading != blank -%}<div class="phbl-heading"><h2 class="h3">{{ section.settings.heading }}</h2></div>{%- endif -%}
  <div class="phbl-grid" style="--cols-mobile: 1; --cols-desktop: {{ section.blocks.size | at_most: 3 | at_least: 1 }}">
    {%- for block in section.blocks -%}
      {%- assign m = block.settings.image_mobile | default: block.settings.image -%}
      <a href="{{ block.settings.link | default: '#' }}" {{ block.shopify_attributes }} style="display:block;border-radius:var(--phbl-radius);overflow:hidden">
        {%- if block.settings.image != blank -%}
          <picture>
            <source media="(min-width: 990px)" srcset="{{ block.settings.image | image_url: width: 1000 }}">
            {{ m | image_url: width: 900 | image_tag: loading: 'lazy', widths: '375,600,900', sizes: '(min-width: 990px) 33vw, 100vw', alt: block.settings.alt, style: 'width:100%;height:auto;display:block' }}
          </picture>
        {%- else -%}
          <div style="aspect-ratio:16/9;background:var(--phbl-secondary)">{{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}</div>
        {%- endif -%}
      </a>
    {%- endfor -%}
  </div>
</div>
{% schema %}
{
  "name": "PHBL Promo banners",
  "tag": "section",
  "settings": [{ "type": "text", "id": "heading", "label": "Heading (optional)" }],
  "blocks": [
    {
      "type": "banner",
      "name": "Banner",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Desktop image" },
        { "type": "image_picker", "id": "image_mobile", "label": "Mobile image (optional)" },
        { "type": "text", "id": "alt", "label": "Alt text", "default": "Offer" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "max_blocks": 3,
  "presets": [{ "name": "PHBL Promo banners", "blocks": [{ "type": "banner" }, { "type": "banner" }] }]
}
{% endschema %}
