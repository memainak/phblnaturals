{%- comment -%}
  Auto-scrolling strip of short customer reviews, read from `testimonial` metaobjects.
  Pauses on hover and for prefers-reduced-motion.
{%- endcomment -%}
{%- assign entries = shop.metaobjects.testimonial.values -%}
{%- if entries.size > 0 -%}
  {%- style -%}
    #shopify-section-{{ section.id }} .phbl-marquee__track { animation-duration: {{ entries.size | times: section.settings.speed }}s; }
  {%- endstyle -%}
  <div class="phbl-section" style="background: {{ section.settings.bg }}">
    <div class="page-width">
      <div class="phbl-heading" style="justify-content:center;text-align:center">
        <h2 class="h4" style="letter-spacing:.06em;text-transform:uppercase">{{ section.settings.heading }}</h2>
      </div>
      {%- if section.settings.count_text != blank -%}
        <p class="phbl-muted" style="text-align:center;margin:-1rem 0 1.6rem">{{ section.settings.count_text }}</p>
      {%- endif -%}
    </div>
    <div class="phbl-marquee">
      <div class="phbl-marquee__track">
        {%- for pass in (1..2) -%}
          {%- for t in entries -%}
            <figure class="phbl-marquee__item" {% if pass == 2 %}aria-hidden="true"{% endif %}>
              <div class="phbl-card__rating"><span class="star" aria-hidden="true">★★★★★</span></div>
              <blockquote>{{ t.quote.value | truncate: 140 }}</blockquote>
              <figcaption class="phbl-muted">
                <strong>{{ t.name.value }}</strong>
                {%- if t.product != blank %} · {{ t.product.value.title | truncate: 34 }}{% endif -%}
              </figcaption>
            </figure>
          {%- endfor -%}
        {%- endfor -%}
      </div>
    </div>
  </div>
{%- endif -%}
{% schema %}
{
  "name": "PHBL Reviews marquee",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "What our customers say" },
    { "type": "text", "id": "count_text", "label": "Line under heading", "info": "e.g. the number of reviews. Only state a number you can back up." },
    { "type": "range", "id": "speed", "label": "Seconds per review", "min": 2, "max": 10, "step": 1, "default": 4 },
    { "type": "color", "id": "bg", "label": "Background", "default": "#FAF7F0" }
  ],
  "presets": [{ "name": "PHBL Reviews marquee" }]
}
{% endschema %}
