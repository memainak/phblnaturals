{%- comment -%} FAQ page from all `faq` metaobjects (question, answer rich text, optional category) + FAQPage JSON-LD. {%- endcomment -%}
{%- assign faqs = shop.metaobjects.faq.values -%}
<div class="phbl-section page-width" style="max-width:80rem">
  <h2 class="h3">{{ section.settings.heading }}</h2>
  {%- assign last_cat = '' -%}
  {%- for f in faqs -%}
    {%- if section.settings.group and f.category != blank and f.category.value != last_cat -%}
      <h3 class="h5" style="margin-top:2.4rem">{{ f.category.value }}</h3>
      {%- assign last_cat = f.category.value -%}
    {%- endif -%}
    <details class="phbl-acc"><summary>{{ f.question.value }}</summary><div class="phbl-acc__body rte">{{ f.answer | metafield_tag }}</div></details>
  {%- endfor -%}
</div>
{%- if faqs.size > 0 -%}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {%- for f in faqs -%}
          { "@type": "Question", "name": {{ f.question.value | json }}, "acceptedAnswer": { "@type": "Answer", "text": {{ f.answer | metafield_tag | strip_html | json }} } }{% unless forloop.last %},{% endunless %}
        {%- endfor -%}
      ]
    }
  </script>
{%- endif -%}
{% schema %}
{
  "name": "PHBL FAQ",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Frequently asked questions" },
    { "type": "checkbox", "id": "group", "label": "Group by category (sort entries by category in Admin)", "default": true }
  ],
  "presets": [{ "name": "PHBL FAQ" }]
}
{% endschema %}
