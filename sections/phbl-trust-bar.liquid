{%- comment -%} Slim strip of delivery/returns promises. Keep every claim true. {%- endcomment -%}
<div class="phbl-trustbar" style="background: {{ section.settings.bg }}; color: {{ section.settings.fg }}">
  <div class="page-width phbl-trustbar__inner">
    {%- for block in section.blocks -%}
      <span class="phbl-trustbar__item" {{ block.shopify_attributes }}>
        {%- if block.settings.icon != blank -%}
          {{ block.settings.icon | image_url: width: 64 | image_tag: loading: 'lazy', width: 24, height: 24, alt: '' }}
        {%- endif -%}
        {{ block.settings.text }}
      </span>
    {%- endfor -%}
  </div>
</div>
{% schema %}
{
  "name": "PHBL Trust bar",
  "tag": "section",
  "settings": [
    { "type": "color", "id": "bg", "label": "Background", "default": "#2F5D3A" },
    { "type": "color", "id": "fg", "label": "Text", "default": "#FFFFFF" }
  ],
  "blocks": [
    { "type": "item", "name": "Promise", "settings": [
      { "type": "image_picker", "id": "icon", "label": "Icon (optional)" },
      { "type": "text", "id": "text", "label": "Text", "default": "Free delivery above ₹499" }
    ] }
  ],
  "max_blocks": 5,
  "presets": [{ "name": "PHBL Trust bar", "blocks": [{ "type": "item" }, { "type": "item" }, { "type": "item" }, { "type": "item" }] }]
}
{% endschema %}
