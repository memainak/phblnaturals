<div class="phbl-section page-width">
  <details class="phbl-acc" {% if section.settings.open %}open{% endif %}>
    <summary><h2 class="h5" style="margin:0">{{ section.settings.heading }}</h2></summary>
    <div class="phbl-acc__body rte">{{ section.settings.text }}</div>
  </details>
</div>
{% schema %}
{
  "name": "PHBL SEO text",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Natural skin, hair & body care by PHBL Naturals" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Write 200–400 words about the brand, product range and key ingredients for search engines. Keep claims cosmetic.</p>" },
    { "type": "checkbox", "id": "open", "label": "Open by default", "default": false }
  ],
  "presets": [{ "name": "PHBL SEO text" }]
}
{% endschema %}
