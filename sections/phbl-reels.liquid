{%- comment -%} Shoppable vertical videos. Videos load with preload="none" and play only while on screen. {%- endcomment -%}
<div class="phbl-section page-width">
  <div class="phbl-heading"><h2 class="h3">{{ section.settings.heading }}</h2></div>
  <div class="phbl-scroller" style="grid-auto-columns: minmax(16rem, 1fr)">
    {%- for block in section.blocks -%}
      {%- assign p = block.settings.product -%}
      <div class="phbl-reel" {{ block.shopify_attributes }}>
        {%- if block.settings.video != blank -%}
          {{ block.settings.video | video_tag: muted: true, loop: true, playsinline: true, preload: 'none', image_size: '540x' }}
        {%- endif -%}
        {%- if p != blank -%}
          {%- assign v = p.selected_or_first_available_variant -%}
          <div class="phbl-reel__product">
            {{ p.featured_media | image_url: width: 100 | image_tag: loading: 'lazy', alt: '' }}
            <div><strong style="display:block;line-height:1.3">{{ p.title | truncate: 38 }}</strong>{{ v.price | money }}</div>
            {%- if p.available -%}<button type="button" class="phbl-btn phbl-btn--sm" data-quick-add data-variant-id="{{ v.id }}">{{ 'products.product.add_to_cart' | t }}</button>{%- endif -%}
          </div>
        {%- endif -%}
      </div>
    {%- endfor -%}
  </div>
</div>
<script>
  document.querySelectorAll('#shopify-section-{{ section.id }} .phbl-reel video').forEach((v) => {
    new IntersectionObserver(([e]) => (e.isIntersecting ? v.play().catch(() => {}) : v.pause()), { threshold: 0.6 }).observe(v);
  });
</script>
{% schema %}
{
  "name": "PHBL Shoppable reels",
  "tag": "section",
  "settings": [{ "type": "text", "id": "heading", "label": "Heading", "default": "Watch It. Love It." }],
  "blocks": [
    {
      "type": "reel",
      "name": "Reel",
      "settings": [
        { "type": "video", "id": "video", "label": "Vertical video (9:16, under 10 MB)" },
        { "type": "product", "id": "product", "label": "Product" }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [{ "name": "PHBL Shoppable reels", "blocks": [{ "type": "reel" }, { "type": "reel" }, { "type": "reel" }] }]
}
{% endschema %}
