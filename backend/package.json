{
  "name": "phbl-naturals-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Backend for the PHBL Naturals storefront: catalogue, accounts, cart, orders, payments and admin. Runs as a Firebase Function over Firestore.",
  "main": "functions.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "seed": "node src/seed.js",
    "smoke": "node tools/smoke.mjs",
    "race": "node tools/race.mjs",
    "emulator": "firebase emulators:start --only firestore --project phbl-naturals-local"
  },
  "engines": {
    "node": "22"
  },
  "dependencies": {
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "firebase-admin": "^13.6.0",
    "firebase-functions": "^6.6.0",
    "razorpay": "^2.9.6"
  }
}
