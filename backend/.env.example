# Copy this file to .env.local and fill it in. Never commit it.
#
# The name matters: this folder is the Cloud Functions source directory, and
# `firebase deploy` treats a `.env` here as the PRODUCTION environment — it
# would ship these development values live and override Secret Manager.
# `.env.local` is only ever applied to the emulators.
#
# In production none of the Firebase values below are needed: Cloud Functions
# supplies the project id and the credentials, and the secrets come from Secret
# Manager. This file is for running the server on your own machine.

PORT=4000
NODE_ENV=development

# Where the static storefront lives. Relative paths resolve from the backend folder.
FRONTEND_DIR=../frontend/phbl_naturals_website

# Comma-separated list of origins allowed to call the API from a browser.
# Leave empty when the backend serves the storefront itself (same origin).
CORS_ORIGINS=

# --- Database -------------------------------------------------------------
#
# Leave DATABASE_URL blank for local work. The server then uses PGlite — real
# Postgres compiled to WASM, kept in data/pg — so you need no database server,
# no Docker and no Supabase account to run the site or the tests.
#
# Set it to point at a real Postgres instead. For Supabase, copy the
# **Connection Pooling** URI from Project Settings > Database (port 6543), not
# the direct connection (5432): see DEPLOY.md for why that matters.
#
#   DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
#
# Pointing this at the live database means local runs write to the real shop,
# so prefer PGlite for development.

DATABASE_URL=

# Connections per pool. The default adapts: 2 on Cloud Functions, 5 for a
# long-running server. Only set this if you know you need to.
PG_POOL_MAX=

# --- Secrets --------------------------------------------------------------
# In production these come from Secret Manager, not from a file:
#   firebase functions:secrets:set SESSION_SECRET

# Long random string used to sign session cookies. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=

# Long random string. Required for /admin and every /api/admin route.
ADMIN_KEY=

# Razorpay API keys: Dashboard > Account & Settings > API Keys.
# Leave blank to run with Cash on Delivery only; online payment is then disabled.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Razorpay webhook secret: Dashboard > Settings > Webhooks.
# Add https://yourdomain.com/api/payments/razorpay/webhook and subscribe to
# payment.captured and payment.failed.
RAZORPAY_WEBHOOK_SECRET=

# Order economics, in paise-free rupees.
FREE_SHIPPING_OVER=699
SHIPPING_FLAT=59
COD_FEE=29
