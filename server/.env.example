# Copy this file to .env and fill it in. Never commit .env.

# Razorpay API keys: Dashboard > Account & Settings > API Keys.
# Start with TEST keys (rzp_test_...). Switch to LIVE keys only after a successful test order.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# Razorpay webhook secret: Dashboard > Settings > Webhooks > add the URL
# https://yourdomain.com/api/razorpay/webhook and subscribe to payment.captured
RAZORPAY_WEBHOOK_SECRET=

# Any long random string. Needed for /admin.html and the admin API.
ADMIN_KEY=

PORT=3000
