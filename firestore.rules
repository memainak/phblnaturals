rules_version = '2';

// Nothing reaches Firestore from a browser. Every read and write goes through
// the Express API, which uses the Admin SDK and therefore bypasses these rules
// entirely. Denying everything here means a leaked Firebase web config cannot
// be used to read orders, customers or password hashes.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
